{
  "name": "code-buster",
  "version": "0.1.0",
  "description": "Code Buster — local-first source repository investigation",
  "type": "module",
  "bin": {
    "codebuster": "dist/src/cli.js",
    "localcode": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "web/dist",
    "README.md"
  ],
  "scripts": {
    "build:backend": "tsc -p tsconfig.json",
    "build:frontend": "npm run build --prefix web",
    "build": "npm run build:backend && npm run build:frontend",
    "dev:backend": "node --watch dist/src/server.js",
    "dev:frontend": "npm run dev --prefix web",
    "dev": "npm run build:backend && concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "start": "npm run build && node dist/src/server.js",
    "test": "npm run build:backend && node --test dist/test/**/*.test.js",
    "codebuster": "npm run build:backend --silent && node dist/src/cli.js",
    "localcode": "npm run codebuster"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@huggingface/transformers": "3.8.1",
    "concurrently": "^9.2.5",
    "tree-sitter-wasm": "2.0.4",
    "typescript": "^5.9.3",
    "web-tree-sitter": "0.27.1"
  },
  "overrides": {
    "sharp": "0.35.5",
    "global-agent": "4.1.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "playwright": "^1.64.1"
  }
}
